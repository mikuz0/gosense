<?xml version="1.0" encoding="utf-8"?>
<com.draekko.traypreferences.TrayPreferenceScreen
    app:key="PREF_KEY_PREFERENCE_SCREEN"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" >

    <com.draekko.traypreferences.TrayPreferenceCategory
        android:layout="@layout/settings_title_text_material"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:title="@string/app_settings_title">

        <com.draekko.traypreferences.TraySwitchPreference
            app:defaultValue="false"
            app:key="@string/PREF_KEY_IS_IMPERIAL_TEMP"
            app:summary="@string/PREF_STR_IS_IMPERIAL_TEMP_summary"
            app:title="@string/PREF_STR_IS_IMPERIAL_TEMP_title" />

        <com.draekko.traypreferences.TraySwitchPreference
            app:defaultValue="false"
            app:key="@string/PREF_KEY_IS_WINTER_SEASON"
            app:summary="@string/PREF_STR_WINTER_SEASON_summary"
            app:title="@string/PREF_STR_WINTER_SEASON_title" />

        <com.draekko.traypreferences.TrayDropDownPreference
            app:defaultValue="1"
            app:key="@string/PREF_KEY_AIR_PRESSURE_UNIT"
            app:summary="@string/PREF_STR_AIR_PRESSURE_UNIT_summary"
            app:title="@string/PREF_STR_AIR_PRESSURE_UNIT_title"
            app:entries="@array/pressure_units"
            app:entryValues="@array/pref_pressure_units" />

        <com.draekko.traypreferences.TraySwitchPreference
            app:defaultValue="true"
            app:key="@string/PREF_KEY_DO_AUTO_SCALE"
            app:summary="@string/PREF_STR_DO_AUTO_SCALE_summary"
            app:title="@string/PREF_STR_DO_AUTO_SCALE_title" />

        <com.draekko.traypreferences.TraySwitchPreference
            app:defaultValue="true"
            app:key="@string/PREF_KEY_AVERAGE_GRAPH_DATA"
            app:summary="@string/PREF_STR_AVERAGE_GRAPH_DATA_summary"
            app:title="@string/PREF_STR_AVERAGE_GRAPH_DATA_title" />

        <com.draekko.traypreferences.TraySeekBarPreference
            app:defaultValue="1"
            app:key="@string/PREF_KEY_GRAPH_UPDATE_INTERVAL"
            app:max="60"
            app:min="5"
            app:seekBarIncrement="1"
            app:displayIncrement="1"
            app:showSeekBarValue="true"
            app:summary="@string/PREF_STR_GRAPH_UPDATE_INTERVAL_summary"
            app:title="@string/PREF_STR_GRAPH_UPDATE_INTERVAL_title" />

    </com.draekko.traypreferences.TrayPreferenceCategory>

    <com.draekko.traypreferences.TrayPreferenceCategory
        android:layout="@layout/settings_title_text_material"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:title="@string/bluetooth_title">

        <com.draekko.traypreferences.TrayDropDownPreference
            app:defaultValue="1"
            app:key="@string/PREF_KEY_BLE_SCAN_MODE"
            app:summary="@string/PREF_STR_BLE_SCAN_MODE_summary"
            app:title="@string/PREF_STR_BLE_SCAN_MODE_title"
            app:entries="@array/ble_scan_mode"
            app:entryValues="@array/ble_scan_mode_values" />

        <com.draekko.traypreferences.TrayDropDownPreference
            app:defaultValue="1"
            app:key="@string/PREF_KEY_SCAN_SORT_ORDER"
            app:summary="@string/PREF_STR_SCAN_SORT_ORDER_summary"
            app:title="@string/PREF_STR_SCAN_SORT_ORDER_title"
            app:entries="@array/scan_order_priority_entries"
            app:entryValues="@array/scan_order_priority_values" />

        <com.draekko.traypreferences.TraySwitchPreference
            app:defaultValue="false"
            app:key="@string/PREF_KEY_AUTOCONNECT_BT_ON_START"
            app:summary="@string/PREF_STR_AUTOCONNECT_BT_ON_START_summary"
            app:title="@string/PREF_STR_AUTOCONNECT_BT_ON_START_title" />

        <com.draekko.traypreferences.TraySwitchPreference
            app:defaultValue="true"
            app:key="@string/PREF_KEY_AUTOCONNECT_BT_ON_DISCONNECT"
            app:summary="@string/PREF_STR_AUTOCONNECT_BT_ON_DISCONNECT_summary"
            app:title="@string/PREF_STR_AUTOCONNECT_BT_ON_DISCONNECT_title" />

        <com.draekko.traypreferences.TraySwitchPreference
            app:defaultValue="true"
            app:key="@string/PREF_KEY_USE_NEW_CONNECTION_AS_PRIMARY"
            app:summary="@string/PREF_STR_USE_NEW_CONNECTION_AS_PRIMARY_summary"
            app:title="@string/PREF_STR_USE_NEW_CONNECTION_AS_PRIMARY_title" />

    </com.draekko.traypreferences.TrayPreferenceCategory>

    <com.draekko.traypreferences.TrayPreferenceCategory
        android:layout="@layout/settings_title_text_material"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:title="@string/miscellaneous_title">

        <com.draekko.traypreferences.TrayPreference
            app:key="@string/PREF_KEY_BATTERY_OPTIMIZATION"
            app:summary="@string/PREF_STR_BATTERY_OPTIMIZATION_summary"
            app:title="@string/PREF_STR_BATTERY_OPTIMIZATION_title" />

    </com.draekko.traypreferences.TrayPreferenceCategory>

    <com.draekko.traypreferences.TrayPreferenceCategory
        android:layout="@layout/settings_title_text_material"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:title="@string/data_title">

        <com.draekko.traypreferences.TrayDropDownPreference
            app:defaultValue="1"
            app:key="@string/PREF_KEY_DATA_RETENTION_INTERVAL"
            app:summary="@string/PREF_STR_DATA_RETENTION_INTERVAL_summary"
            app:title="@string/PREF_STR_DATA_RETENTION_INTERVAL_title"
            app:entries="@array/data_retention_interval"
            app:entryValues="@array/pref_data_retention_interval" />

        <com.draekko.traypreferences.TrayPreference
            app:key="@string/PREF_KEY_CLEAR_DATABASE"
            app:summary="@string/PREF_STR_CLEAR_DATABASE_summary"
            app:title="@string/PREF_STR_CLEAR_DATABASE_title" />

        <com.draekko.traypreferences.TrayPreference
            app:key="@string/PREF_KEY_BT_IMPORT_DATABASE"
            app:summary="@string/PREF_STR_BT_IMPORT_DATABASE_summary"
            app:title="@string/PREF_STR_BT_IMPORT_DATABASE_title" />

        <com.draekko.traypreferences.TrayPreference
            app:key="@string/PREF_KEY_BT_EXPORT_DATABASE"
            app:summary="@string/PREF_STR_BT_EXPORT_DATABASE_summary"
            app:title="@string/PREF_STR_BT_EXPORT_DATABASE_title" />

    </com.draekko.traypreferences.TrayPreferenceCategory>

    <com.draekko.traypreferences.TrayPreferenceCategory
        android:layout="@layout/settings_title_text_material"
        app:key="@string/PREF_KEY_DEVELOPER"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:title="@string/developer_title">

        <com.draekko.traypreferences.TrayPreference
            app:key="@string/PREF_KEY_RESET_EVERYTHING"
            app:summary="@string/PREF_STR_RESET_EVERYTHING_summary"
            app:title="@string/PREF_STR_RESET_EVERYTHING_title" />

    </com.draekko.traypreferences.TrayPreferenceCategory>

</com.draekko.traypreferences.TrayPreferenceScreen>
