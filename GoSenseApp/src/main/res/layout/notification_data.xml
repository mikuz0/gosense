<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/bpmLayout"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_margin="8dp" >

        <LinearLayout
            android:id="@+id/topframe"
            android:weightSum="3"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/notifyAppTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="start"
                android:gravity="start"
                android:textColor="@color/white"
                android:text="@string/app_name"
                android:textAlignment="viewStart"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/notifyTitleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:textColor="@color/white"
                android:text="BLUETOOTH DEVICE"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/notifyBatteryTextView"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="end"
                android:gravity="end"
                android:textColor="@color/white"
                android:textAlignment="viewEnd"
                android:text="\?\?%"
                android:textStyle="bold"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_alignParentBottom="true"
            android:layout_below="@+id/topframe"
            android:gravity="center_horizontal"
            android:weightSum="3"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/notifyTemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_gravity="start"
                android:gravity="start"
                android:layout_weight="0.5"
                android:textColor="@color/white"
                android:text="20.3 C"
                android:textSize="12dp"
                android:textAlignment="viewStart"
                android:textStyle="italic|bold" />

            <TextView
                android:id="@+id/notifyRelativeHumaidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:textColor="@color/white"
                android:text="33%"
                android:textSize="12dp"
                android:textAlignment="center"
                android:textStyle="italic|bold" />

            <TextView
                android:id="@+id/notifyAirPressure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:layout_gravity="end"
                android:layout_marginStart="10dp"
                android:gravity="end"
                android:textColor="@color/white"
                android:text="1004.4 mbar"
                android:textAlignment="viewEnd"
                android:textSize="12dp"
                android:textStyle="italic|bold" />

        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>
