<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/deviceframe"
    android:orientation="horizontal"
    android:layout_marginTop="1dp"
    android:layout_marginBottom="1dp"
    android:layout_width="match_parent"
    android:background="@drawable/selection_ripple"
    android:layout_height="50dp">

    <CheckBox
        android:id="@+id/deviceselected"
        android:layout_alignParentStart="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="0dp"
        android:gravity="center"
        android:layout_centerVertical="true"
        android:layout_width="32dp"
        android:layout_height="32dp" />

    <TextView
        android:id="@+id/devicename"
        android:layout_toRightOf="@+id/deviceselected"
        android:layout_marginStart="8dp"
        android:layout_marginTop="6dp"
        android:textAlignment="center"
        android:text="BLUETOOTH DEVICE"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/deviceaddress"
        android:layout_below="@+id/devicename"
        android:layout_alignStart="@+id/devicename"
        android:textAlignment="center"
        android:text="00:00:00:00"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/devicerssi"
        android:layout_marginEnd="15dp"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@+id/devicebattery"
        android:textAlignment="center"
        android:text="-100 dBm"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/devicebattery"
        android:layout_toLeftOf="@+id/devicebatteryicon"
        android:layout_marginEnd="1dp"
        android:layout_centerVertical="true"
        android:textAlignment="center"
        android:text="\?\?\?%"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <ImageView
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="15dp"
        app:tint="@color/white"
        android:tint="@color/white"
        android:id="@+id/devicebatteryicon"
        android:src="@drawable/ic_baseline_battery_unknown_24"
        android:layout_width="18dp"
        android:layout_height="18dp"
        tools:ignore="UseAppTint" />

</RelativeLayout>
